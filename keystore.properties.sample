# FoxFW Companion — release signing (OPTIONAL)
#
# You do NOT need this file to build the app. With no keystore.properties present,
# `release` builds are signed with the debug key so they still build and install —
# fine for compiling it yourself. Only the official published release uses the real key.
#
# To produce an official signed release: copy this file to `keystore.properties`
# (same folder, repo root) and fill in your own values. keystore.properties is
# git-ignored and must never be committed.
#
# storeFile may be absolute or relative to the repo root.
storeFile=C:/path/to/your-release.keystore
storePassword=your-store-password
keyAlias=your-key-alias
keyPassword=your-key-password
